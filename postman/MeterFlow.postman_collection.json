    {
      "name": "6. API keys",
      "item": [
        {
          "name": "Create API key",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/customers/{{customerId}}/api-keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "customers",
                "{{customerId}}",
                "api-keys"
              ]
            },
            "description": "The raw key is returned only at creation. This request saves it locally as the apiKey collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set(\"apiKeyId\", data.id);",
                  "    pm.collectionVariables.set(\"apiKey\", data.apiKey);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List API keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/customers/{{customerId}}/api-keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "customers",
                "{{customerId}}",
                "api-keys"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "7. Data plane",
      "item": [
        {
          "name": "Authenticated ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ping"
              ]
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "8. Cleanup (changes server state)",
      "item": [
        {
          "name": "Revoke API key",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/customers/{{customerId}}/api-keys/{{apiKeyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "customers",
                "{{customerId}}",
                "api-keys",
                "{{apiKeyId}}"
              ]
            },
            "description": "Revokes the saved API key. Run after authenticated ping."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Cancel active subscription",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/subscriptions/active/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}",
                "subscriptions",
                "active",
                "cancel"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
