              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "plans",
                "{{planCode}}"
              ]
            },
            "description": "All fields are optional; omit fields you do not want to update.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Updated demo plan\",\n  \"requestsPerMinute\": 120,\n  \"monthlyQuota\": 20000,\n  \"active\": true\n}",
              "options": {
