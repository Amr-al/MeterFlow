{
  "info": {
    "name": "MeterFlow API",
    "description": "All current MeterFlow controller endpoints plus exposed Actuator health/info. Run folders in order on a fresh database. Successful create requests save IDs, normalized codes and the raw API key in collection variables. Admin and customer routes currently permit unauthenticated access; data-plane routes use X-API-Key. Cleanup requests revoke the key and cancel the subscription. Change productCode and planCode before repeating creation to avoid duplicate-code conflicts. Do not share an exported collection containing a populated apiKey.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "productCode",
      "value": "POSTMAN_DEMO_API",
      "type": "string"
    },
    {
      "key": "planCode",
      "value": "POSTMAN_DEMO_PLAN",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "subscriptionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "apiKeyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "page",
      "value": "0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health and admin ping",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "info"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Admin ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "ping"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "2. API products",
      "item": [
        {
          "name": "Create API product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/api-products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api-products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{productCode}}\",\n  \"displayName\": \"Demo API product\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set(\"productCode\", data.code);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List API products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/api-products?page={{page}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api-products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}"
                }
              ]
            },
            "description": "Pages contain 10 products. Page numbering starts at 0."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update API product status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/api-products/{{productCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api-products",
                "{{productCode}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
